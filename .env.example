# ==============================================================================
# X CHATTER - Environment Configuration (Supabase & Backend)
# ==============================================================================

# Server
PORT=4000
NODE_ENV=development

# JWT Secret Keys
JWT_SECRET=super-secret-jwt-key-replace-in-production
REFRESH_SECRET=super-secret-refresh-key-replace-in-production

# Redis (for presence, token blacklisting, and Socket.io cluster adapter)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...<your-service-role-key>

# ------------------------------------------------------------------------------
# SUPABASE DATABASE URLS (Prisma ORM)
# Found in: Supabase Dashboard -> Project Settings -> Database
# ------------------------------------------------------------------------------
# 1. Transaction Pooler (Port 6543) - Used by Prisma Client queries in production
DATABASE_URL="postgres://postgres.<your-project-ref>:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Session Connection (Port 5432) - Used for Prisma migrations & schema pushes
DIRECT_URL="postgres://postgres.<your-project-ref>:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# SUPABASE STORAGE BUCKETS
# Create these buckets in Supabase Dashboard -> Storage:
# - avatars (Public bucket)
# - streak-snaps (Private bucket, 24h retention)
# - stories-24h (Private bucket, 24h retention)
# ------------------------------------------------------------------------------
